{
    "profiles": [
        {
            "name": "Default profile",
            "selected": true,
            "virtual_hid_keyboard": { "keyboard_type_v2": "ansi" },
            "complex_modifications": {
                "rules": [
                    {
                        "description": "Caps Lock: tap for escape, hold for control+option+command",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "caps_lock",
                                    "modifiers": { "optional": ["any"] }
                                },
                                "to": [
                                    {
                                        "key_code": "left_control",
                                        "modifiers": ["left_option", "left_command"]
                                    }
                                ],
                                "to_if_alone": [{ "key_code": "escape" }]
                            }
                        ]
                    },
                    {
                        "description": "Control+Option+Command+Shift+Return: new Safari window",
                        "manipulators": [
                            {
                                "type": "basic",
                                "from": {
                                    "key_code": "return_or_enter",
                                    "modifiers": { "mandatory": ["control", "option", "command", "shift"] }
                                },
                                "to": [
                                    {
                                        "shell_command": "osascript -e 'tell application \"Safari\"' -e 'make new document' -e 'activate' -e 'end tell'"
                                    }
                                ]
                            }
                        ]
                    }
                ]
            }
        }
    ]
}
